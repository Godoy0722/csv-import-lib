msgid "plugins.importexport.csv.invalidSourceDir"
msgstr "The source directory is invalid or does not exist."

msgid "plugins.importexport.csv.filePathEscapesSourceDir"
msgstr "File path \"{$filename}\" escapes the source directory. Filenames must not contain path traversal sequences."

msgid "plugin.importexport.csv.shared.erroWhileSavingCoverImage"
msgstr "An error occurred while copying the cover image."

msgid "plugins.importexport.csv.rowDoesntContainAllFields"
msgstr "Row doesn't contain all fields."

msgid "plugins.importexport.csv.rowContainsTooManyFields"
msgstr "Row contains more fields than expected."

msgid "plugins.importexport.csv.verifyRequiredFieldsForThisRow"
msgstr "Verify the required fields for this row."

msgid "plugins.importexport.csv.invalidCoverImage"
msgstr "The cover image has an invalid format for this row."

msgid "plugins.importexport.csv.invalidFileExtension"
msgstr "The cover image has an invalid extension."

msgid "plugins.importexport.csv.invalidNumberOfLabelsAndGalleys"
msgstr "Galley files don't have the same amount as the labels. Please verify it for this row."

msgid "plugins.importexport.csv.invalidGalleyFile"
msgstr "Missing galley file \"{$filename}\" for this submission."

msgid "plugins.importexport.csv.invalidNumberOfLabelsAndSupplementaryFiles"
msgstr "Supplementary files don't have the same amount as the labels. Please verify it for this row."

msgid "plugins.importexport.csv.invalidSupplementaryFile"
msgstr "Invalid supplementary file \"{$filename}\" for this submission."

msgid "plugins.importexport.csv.invalidNumberOfDescriptionsAndSupplementaryFiles"
msgstr "Supplementary files don't have the same amount as the descriptions. Please verify it for this row."

msgid "plugins.importexport.csv.unknownContext"
msgstr "Unknown {$context} with path \"{$contextPath}\"."

msgid "plugins.importexport.csv.unknownLocale"
msgstr "Unknown locale or locale not supported by this {$context}: \"{$locale}\". Supported locales: {$supportedLocales}"

msgid "plugins.importexport.csv.noGenre"
msgstr "There is no {$genreName} genre."

msgid "plugins.importexport.csv.noAuthorGroup"
msgstr "There is no default author group in the {$context} {$contextPath}."

msgid "plugins.importexport.csv.roleDoesntExist"
msgstr "Role \"{$role}\" doesn't exist."

msgid "plugins.importexport.csv.versionRequiredWhenIdentifierProvided"
msgstr "Version is required when versionIdentifier is provided."

msgid "plugins.importexport.csv.versionMustBePositiveInteger"
msgstr "Version must be a positive integer greater than 0."

msgid "plugins.importexport.csv.duplicatePublicationVersionLocaleFound"
msgstr "A row with identifier \"{$identifier}\", version \"{$version}\", and locale \"{$locale}\" already exists in this import. Please check the row's version and locale combination."

msgid "plugins.importexport.csv.invalidReferencesFile"
msgstr "Invalid references file: \"{$filename}\". Please verify the file exists and is readable."

msgid "plugins.importexport.csv.invalidReferencesFileExtension"
msgstr "References file must have a .txt extension."

msgid "plugins.importexport.csv.invalidOrcidFormat"
msgstr "Invalid ORCID format: \"{$orcid}\". Accepted formats: URL (https://orcid.org/0000-0000-0000-0000), dashed (0000-0000-0000-0000), or numeric (0000000000000000)."

msgid "plugins.importexport.csv.invalidFunderFormat"
msgstr "Invalid funder format at position {$index}. Each funder must have at least a name."

msgid "plugins.importexport.csv.fundingPluginNotEnabled"
msgstr "The Funding plugin is not installed or not enabled for this {$context}. Please enable it before importing rows with funders data."

msgid "plugins.importexport.csv.funderNotInCrossrefRegistry"
msgstr "Funder \"{$funderName}\" at position {$index} is not from the Crossref Funder Registry. The funder identification must be a valid Crossref DOI (e.g., http://dx.doi.org/10.13039/...)."

msgid "plugins.importexport.csv.funderMissingCrossrefId"
msgstr "Funder \"{$funderName}\" at position {$index} is missing a Crossref Funder Registry identification. Please provide a valid Crossref DOI (e.g., http://dx.doi.org/10.13039/...)."

msgid "plugins.importexport.csv.userAlreadyExistsWithUsername"
msgstr "User already exists with username \"{$username}\"."

msgid "plugins.importexport.csv.userAlreadyExistsWithEmail"
msgstr "User already exists with email \"{$email}\"."

msgid "plugins.importexport.csv.errorWhileCreatingPublication"
msgstr "Error while creating publication."

msgid "plugins.importexport.csv.invalidSubmissionViews"
msgstr "The {$fieldName} field must be empty or a non-negative integer."

msgid "plugins.importexport.csv.galleyViewsWithoutGalleys"
msgstr "galleyViews is provided but galleyLabels is empty. Galley labels are required when galley views are specified."

msgid "plugins.importexport.csv.invalidNumberOfGalleyViews"
msgstr "The number of galleyViews values doesn't match the number of galleyLabels. Please verify the semicolon-separated counts match."

msgid "plugins.importexport.csv.invalidGalleyViewValue"
msgstr "Invalid galley view value \"{$value}\". Each galley view must be empty or a non-negative integer."

msgid "plugins.importexport.csv.incompleteSectionFields"
msgstr "Both sectionTitle and sectionAbbrev must be provided together. If one is filled, the other must also be filled."

msgid "plugins.importexport.csv.couldNotOpenFile"
msgstr "Could not read file: \"{$filePath}\". Error: \"{$errorMessage}\"."

msgid "plugins.importexport.csv.dryModeFileHeader"
msgstr "=== {$filename} ==="

msgid "plugins.importexport.csv.dryModeTableHeader"
msgstr "ROW  | STATUS | ERROR"

msgid "plugins.importexport.csv.dryModeFailedRow"
msgstr "{$row}  | FAILED | {$reason}"

msgid "plugins.importexport.csv.dryModeFileSummary"
msgstr "Result: {$passed} passed, {$failed} failed ({$total} total)"

msgid "plugins.importexport.csv.dryModeGrandTotal"
msgstr "--- Data Validation complete: {$files} files, {$passed} passed, {$failed} failed ---"

msgid "plugins.importexport.csv.zipCorruptArchive"
msgstr "Cannot open ZIP archive: \"{$path}\"."

msgid "plugins.importexport.csv.zipBombDetected"
msgstr "ZIP archive rejected: uncompressed size ({$actual}) exceeds the allowed limit ({$limit})."

msgid "plugins.importexport.csv.zipPathTraversal"
msgstr "ZIP archive rejected: entry \"{$entry}\" contains a path traversal sequence."

msgid "plugins.importexport.csv.importLocked"
msgstr "An import is currently in progress. Please wait for it to complete before starting another."

msgid "plugins.importexport.csv.form.submitButton"
msgstr "Import"

msgid "plugins.importexport.csv.form.importing"
msgstr "Processing"

msgid "plugins.importexport.csv.form.imported"
msgstr "Completed"

msgid "plugins.importexport.csv.form.importFile"
msgstr "Import File"

msgid "plugins.importexport.csv.form.importFile.description"
msgstr "Upload a ZIP file containing CSV files and assets (cover images, galley files), or a single CSV file directly."

msgid "plugins.importexport.csv.form.importType"
msgstr "Import Type"

msgid "plugins.importexport.csv.form.importType.users"
msgstr "Users"

msgid "plugins.importexport.csv.form.dryMode"
msgstr "Data Validation"

msgid "plugins.importexport.csv.form.dryMode.description"
msgstr "Validate all CSV data without writing to the database. Review results before running a real import."

msgid "plugins.importexport.csv.form.dryMode.enable"
msgstr "Enable Data Validation mode"

msgid "plugins.importexport.csv.form.sendWelcomeEmail"
msgstr "Welcome Email"

msgid "plugins.importexport.csv.form.sendWelcomeEmail.enable"
msgstr "Send welcome email to imported users"

msgid "plugins.importexport.csv.uploadFailed"
msgstr "File upload failed."

msgid "plugins.importexport.csv.invalidImportType"
msgstr "Invalid import type: \"{$importType}\"."

msgid "plugins.importexport.csv.zipExtractionFailed"
msgstr "Failed to extract ZIP file: {$reason}"

msgid "plugins.importexport.csv.results.dryModeTitle"
msgstr "Data Validation Results"

msgid "plugins.importexport.csv.results.importCompleteTitle"
msgstr "Import Complete"

msgid "plugins.importexport.csv.results.importType"
msgstr "Import Type"

msgid "plugins.importexport.csv.results.filesProcessed"
msgstr "Files Processed"

msgid "plugins.importexport.csv.results.totalRows"
msgstr "Total Rows"

msgid "plugins.importexport.csv.results.successfulRows"
msgstr "Successful Rows"

msgid "plugins.importexport.csv.results.failedRows"
msgstr "Failed Rows"

msgid "plugins.importexport.csv.results.invalidFiles"
msgstr "Download invalid rows"

msgid "plugins.importexport.csv.results.intro.issues"
msgstr "This is the result of importing <b>issues and articles</b>. Every row of your CSV files was processed: rows that succeeded were saved to the journal, and any that failed are listed further down together with the reason they could not be imported."

msgid "plugins.importexport.csv.results.intro.issues.dryMode"
msgstr "This is a <b>Data Validation</b> for <b>issues and articles</b> — nothing was saved to the journal. The summary below is a preview of what a real import would do: it shows which rows would be created and which would fail, along with the reason for each failure. When you are happy with the result, disable <b>Data Validation</b> and import again to apply the changes."

msgid "plugins.importexport.csv.results.intro.users"
msgstr "This is the result of importing <b>users</b>. Every row of your CSV files was processed: rows that succeeded were created as user accounts, and any that failed are listed further down together with the reason they could not be imported."

msgid "plugins.importexport.csv.results.intro.users.dryMode"
msgstr "This is a <b>Data Validation</b> for <b>users</b> — no accounts were created. The summary below is a preview of what a real import would do: it shows which rows would be created and which would fail, along with the reason for each failure. When you are happy with the result, disable <b>Data Validation</b> and import again to apply the changes."

msgid "plugins.importexport.csv.results.legend"
msgstr "The counters below show the totals for this run, followed by a per-file breakdown. Each failed row is listed with its row number and the reason it failed, so you can fix it in the CSV and import again."

msgid "plugins.importexport.csv.results.invalidFilesHint"
msgstr "For every CSV that had failed rows, a downloadable copy named <b>invalid_&lt;your-file&gt;.csv</b> is generated containing only those failed rows. Click the file name shown below each error table to download it, fix the rows, and import again."

msgid "plugins.importexport.csv.ExecutedInNSeconds"
msgstr "Executed in: {$seconds} seconds.\n"

msgid "plugins.importexport.csv.form.userImportHelp"
msgstr "<b>Users:</b> For user imports, you can upload a single CSV file directly without zipping. If you have multiple CSV files, bundle them into a ZIP archive following the same structure rules described above."

msgid "plugins.importexport.csv.userUpdated"
msgstr "User \"{$email}\" updated."

msgid "plugins.importexport.csv.results.createdRows"
msgstr "Created"

msgid "plugins.importexport.csv.results.updatedRows"
msgstr "Updated"

msgid "plugins.importexport.csv.results.updatedUsersSection"
msgstr "UPDATED USERS"

msgid "plugins.importexport.csv.results.updatedUsersExplanation"
msgstr "Users marked as updated were found by email. Profile data (name, affiliation, country, email, ORCID) was updated. Password and roles were left unchanged — only new users receive password and role assignments."

msgid "plugins.importexport.csv.contextPathMismatch"
msgstr "The CSV row's {$contextType}Path \"{$csvContextPath}\" does not match the currently opened {$contextType} \"{$currentContextPath}\". Rows must belong to the same {$contextType} context."

msgid "plugins.importexport.csv.invalidDateFormat"
msgstr "Invalid date format for {$fieldName}. Expected format: YYYY-MM-DD (e.g., 2024-01-15)."

msgid "plugins.importexport.csv.duplicateDoi"
msgstr "The DOI \"{$doi}\" already exists in this journal."

msgid "plugins.importexport.csv.submissionFileProcessFinished"
msgstr "Process for file \"{$filename}\" finished. {$processedRows} processed, {$failedRows} failed."

msgid "plugins.importexport.csv.rowImportFailed"
msgstr "Unexpected error while importing this row: {$message}"

